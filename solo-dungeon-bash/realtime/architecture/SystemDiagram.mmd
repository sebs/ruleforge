        MAP_OVERLAY["MapOverlay"]:::ui
        POTION_UI["PotionDisplay"]:::ui
        REACH_WARN["ReachabilityWarning"]:::ui
        CAMERA["CameraController"]:::ui
        ANIM_SYS["AnimationSystem"]:::ui
        VFX_SYS["VFXSystem (pools)"]:::ui
        MENUS["MainMenu / PauseMenu / Settings"]:::ui
        TUTORIAL["TutorialRoom"]:::ui
        END_SCREEN["EndScreen"]:::ui
        DEBUG_OVERLAY["DebugOverlay (F3)"]:::ui
    end

    %% ====================================================================
    %% DATA LAYER
    %% ====================================================================
    subgraph DATA["Data Layer"]
        LEVEL_TABLES["level_tables.json"]:::data
        MONSTERS_JSON["monsters.json"]:::data
        ITEMS_JSON["items.json"]:::data
        BALANCE_JSON["balance.json"]:::data
        STRINGS["strings.csv (i18n)"]:::data
        AUDIO_MANIFEST["audio_manifest.json"]:::data
        SAVE_CURRENT["user://runs/current.json"]:::data
        SAVE_BAK["user://runs/current.bak"]:::data
        SETTINGS_FILE["user://settings.json"]:::data
        BESTIARY["user://bestiary.json"]:::data
        ACHIEVE_FILE["user://achievements.json"]:::data
        TELEM_QUEUE["user://telemetry_queue.json"]:::data
        CRASH_LOG["user://logs/latest.log"]:::data
    end

