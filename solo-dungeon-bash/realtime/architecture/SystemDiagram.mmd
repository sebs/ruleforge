%% Solo Dungeon Dash — System Architecture Diagram
%% Companion to SystemArchitecture.md (§18)
%% Rendered with Mermaid 10+. Use a desktop viewer; the diagram is dense.

flowchart TB

    %% ====================================================================
    %% PLATFORM LAYER
    %% ====================================================================
    subgraph PLATFORM["Platform Layer"]
        OS_PC["Windows / Linux / macOS"]:::platform
        OS_DECK["Steam Deck (Linux native)"]:::platform
        OS_MOB["iOS / Android"]:::platform
        GODOT["Godot 4.3 Runtime"]:::platform
        STEAMSDK["Steam SDK (GDExtension)"]:::platform
        ICLOUD["iCloud Documents"]:::platform
        GPGS["Google Play Games Services"]:::platform
    end

    %% ====================================================================
    %% ENGINE SYSTEMS
    %% ====================================================================
    subgraph ENGINE["Engine Systems (Godot)"]
        SCENE_TREE["SceneTree"]:::engine
        PHYS_SERVER["PhysicsServer2D"]:::engine
        RENDER_SERVER["RenderingServer"]:::engine
        AUDIO_SERVER["AudioServer"]:::engine
        INPUT_SINGLETON["Input Singleton"]:::engine
        FILE_ACCESS["FileAccess / DirAccess"]:::engine
        WORKER_POOL["WorkerThreadPool"]:::engine
        RES_LOADER["ResourceLoader"]:::engine
    end

    %% ====================================================================
    %% GAME SYSTEMS (autoloads + Dungeon subtree)
    %% ====================================================================
    subgraph GAME_SYS["Game Systems"]
        GAME_TICK["GameTick (orchestrator)"]:::sysauto
        RENDER_TICK["RenderTick"]:::sysauto
        INPUT_SYS["InputSystem"]:::sysauto
        TIME_SYS["TimeSystem"]:::sysauto
        RNG["RNG (7 sub-streams)"]:::sysauto
        SETTINGS["Settings"]:::sysauto
        LOCAL["Localization"]:::sysauto
        CATALOG["Catalog (items, monsters, tables)"]:::sysauto
        BALANCE["Balance (constants)"]:::sysauto

        SCENE_MGR["SceneManager"]:::sysdung
        DUNGEON_GEN["DungeonGenerator"]:::sysdung
        ROOM_MGR["RoomManager"]:::sysdung
        REACH["ReachabilityChecker (BFS)"]:::sysdung
        PLAYER_CTRL["PlayerController"]:::sysdung
        ENEMY_AI["EnemyAI"]:::sysdung
        COMBAT_SYS["CombatSystem"]:::sysdung
        DICE_TRAY["DiceTraySystem"]:::sysdung
        ECON_SYS["EconomySystem"]:::sysdung
        SHOP_SYS["ShopSystem"]:::sysdung
    end

    %% ====================================================================
    %% GAME LOGIC (FSMs + pure rules)
    %% ====================================================================
    subgraph LOGIC["Game Logic / FSMs"]
        PLAYER_FSM["Player FSM"]:::logic
        ENEMY_FSM["Enemy FSM"]:::logic
        COMBAT_FSM["Combat Beat FSM"]:::logic
        SCENE_FSM["Scene FSM"]:::logic
        RULES_ENG["RulesEngine (pure fn)"]:::logic
        ENEMY_BEHAVIORS["11 Enemy Behaviour Subclasses"]:::logic
        BOSS_PATTERN["Dracular Pattern Stack"]:::logic
    end

    %% ====================================================================
    %% UI / PRESENTATION
    %% ====================================================================
    subgraph UI["UI / Presentation"]
        HUD["HUDSystem"]:::ui
        HEARTS["HeartsDisplay"]:::ui
